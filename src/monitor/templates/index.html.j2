<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>机会监控 · {{ date }}</title>
<meta name="description" content="基于三篇深度推演报告的每日自动更新信息可视化与机会监控（纯规则，无大模型）">
<meta name="color-scheme" content="light dark">
<link rel="stylesheet" href="assets/app.css">
</head>
<body>
<a class="sr-only" href="#main">跳到内容</a>
<div class="frame">
  <aside class="rail" id="rail" aria-label="主导航">
    <div class="brand">机会监控</div>
    <button class="nv" data-tab="overview" role="tab" aria-selected="true">总览<span class="n" data-count="overview"></span></button>
    <hr>
    <button class="nv" data-tab="crypto" role="tab">加密<span class="n" data-count="crypto"></span></button>
    <button class="nv" data-tab="geo" role="tab">地缘<span class="n" data-count="geo"></span></button>
    <button class="nv" data-tab="ai" role="tab">AI 时代<span class="n" data-count="ai"></span></button>
    <hr>
    <button class="nv" data-tab="track" role="tab">推演追踪<span class="n" data-count="track"></span></button>
    <button class="nv" data-tab="read" role="tab">阅读<span class="n" data-count="read"></span></button>
    <hr>
    <button class="nv" data-tab="data" role="tab">数据<span class="n" data-count="data"></span></button>
    <div class="foot" id="rail-foot"></div>
  </aside>
  <div class="content">
    <header class="top">
      <span class="brand">机会监控</span>
      <span class="date" id="hdr-date">{{ date }}</span>
      <span class="spacer"></span>
      <div id="search-wrap"><input id="search" type="search" placeholder="搜索资产 / 规则 / 新闻（Ctrl+K）" autocomplete="off"><div id="search-results"></div></div>
      <span class="seg" id="mode-seg" title="简明：白话、少字、少图；专业：全部指标与规则"><button data-v="simple">简明</button><button data-v="pro">专业</button></span>
      <button class="iconbtn" id="btn-help" title="快捷键 (?)" aria-label="快捷键"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 1-1 1.7"/><path d="M12 17h.01"/></svg></button>
      <button class="iconbtn" id="btn-settings" title="设置" aria-label="设置" aria-haspopup="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg></button>
    </header>
    <div class="pop" id="pop-settings" role="dialog" aria-label="设置">
      <div class="row"><span>主题</span><span class="seg" data-setting="theme"><button data-v="auto">自动</button><button data-v="light">浅色</button><button data-v="dark">深色</button></span></div>
      <div class="row"><span>涨跌色</span><span class="seg" data-setting="dir"><button data-v="green-up">绿涨红跌</button><button data-v="red-up">红涨绿跌</button></span></div>
      <div class="row"><span>密度</span><span class="seg" data-setting="density"><button data-v="normal">标准</button><button data-v="compact">紧凑</button></span></div>
      <div class="row small muted">设置只保存在本浏览器</div>
    </div>
    <div class="pop" id="pop-help" role="dialog" aria-label="快捷键">
      <div class="row"><span>切换页面</span><span><span class="kbd">1</span>–<span class="kbd">7</span></span></div>
      <div class="row"><span>关闭抽屉/弹层</span><span class="kbd">Esc</span></div>
      <div class="row"><span>打开数字/规则详情</span><span>点击任意读数</span></div>
      <div class="row"><span>阅读页标记已读</span><span>点击标题</span></div>
    </div>
    <div class="strip" id="strip"></div>
    <nav class="tabs" id="tabs" role="tablist" aria-label="页面">
      <button role="tab" data-tab="overview" aria-selected="true">总览</button>
      <button role="tab" data-tab="crypto">加密</button>
      <button role="tab" data-tab="geo">地缘</button>
      <button role="tab" data-tab="ai">AI 时代</button>
      <button role="tab" data-tab="track">推演追踪</button>
      <button role="tab" data-tab="read">阅读</button>
      <button role="tab" data-tab="data">数据</button>
    </nav>
    <main id="main">
      <div class="watchstrip" id="watchstrip"></div>
      <section class="tab" id="tab-overview" data-active="true" role="tabpanel"></section>
      <section class="tab" id="tab-crypto" role="tabpanel"></section>
      <section class="tab" id="tab-geo" role="tabpanel"></section>
      <section class="tab" id="tab-ai" role="tabpanel"></section>
      <section class="tab" id="tab-track" role="tabpanel"></section>
      <section class="tab" id="tab-read" role="tabpanel"></section>
      <section class="tab" id="tab-data" role="tabpanel"></section>
      <div class="footer">本页为基于公开数据与三篇研究报告的自动化监控，不构成投资建议。所有阈值来自报告原文；数据来源与时间戳见「数据」页。规则引擎不使用任何大模型；新闻只做关键词打标与排序，不做改写。</div>
    </main>
  </div>
</div>
<nav class="bottombar" id="bottombar" aria-label="底部导航">
  <button data-tab="overview" aria-selected="true"><svg viewBox="0 0 24 24"><path d="M3 12h7V3H3zM14 21h7v-9h-7zM14 8h7V3h-7zM3 21h7v-5H3z"/></svg>总览<span class="badge" data-badge="overview"></span></button>
  <button data-tab="crypto"><svg viewBox="0 0 24 24"><path d="M12 3v18M7 8h7a3 3 0 0 1 0 6H7m0 0h8a3 3 0 0 1 0 6H7"/></svg>加密</button>
  <button data-tab="geo"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>地缘</button>
  <button data-tab="ai"><svg viewBox="0 0 24 24"><path d="M4 4h16v12H4zM8 20h8M12 16v4"/></svg>AI</button>
  <button data-tab="__more"><svg viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg>更多</button>
</nav>
<div class="sheet" id="sheet">
  <button data-tab="track">推演追踪 <span class="muted small" data-count="track"></span></button>
  <button data-tab="read">阅读 <span class="muted small" data-count="read"></span></button>
  <button data-tab="data">数据 <span class="muted small" data-count="data"></span></button>
</div>
<div class="backdrop" id="backdrop"></div>
<aside class="drawer" id="drawer" role="dialog" aria-label="详情"></aside>
<script id="__DATA__" type="application/json">{{ data_json|safe }}</script>
<script src="assets/echarts.min.js"></script>
<script>
if (!window.echarts) {
  var s = document.createElement('script'); s.src = 'https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js';
  s.onerror = function(){ var t=document.createElement('script'); t.src='https://registry.npmmirror.com/echarts/5.6.0/files/dist/echarts.min.js'; document.head.appendChild(t); };
  document.head.appendChild(s);
}
</script>
<script src="assets/app.js"></script>
</body>
</html>
