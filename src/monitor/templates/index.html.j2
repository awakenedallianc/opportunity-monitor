<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>机会监控 · {{ date }}</title>
<meta name="description" content="基于三篇深度推演报告的每日自动更新信息可视化与机会监控">
<style>
{% raw %}
:root{
  color-scheme:light;
  --page:#f9f9f7;--surface:#fcfcfb;--surface-2:#f3f2ee;--ink:#0b0b0b;--ink-2:#52514e;--muted:#898781;--grid:#e1e0d9;--axis:#c3c2b7;--border:rgba(11,11,11,.10);
  --s1:#2a78d6;--s2:#eb6834;--s3:#1baf7a;--s4:#eda100;--s5:#e87ba4;--s6:#008300;--s7:#4a3aa7;--s8:#e34948;
  --good:#0ca30c;--warn:#fab219;--serious:#ec835a;--critical:#d03b3b;--up:#006300;--down:#b42318;
  --good-bg:rgba(12,163,12,.10);--warn-bg:rgba(250,178,25,.14);--serious-bg:rgba(236,131,90,.14);--critical-bg:rgba(208,59,59,.10);--info-bg:rgba(137,135,129,.12);
  --radius:10px;--shadow:0 1px 2px rgba(0,0,0,.04);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --page:#0d0d0d;--surface:#1a1a19;--surface-2:#232322;--ink:#ffffff;--ink-2:#c3c2b7;--muted:#898781;--grid:#2c2c2a;--axis:#383835;--border:rgba(255,255,255,.10);
    --s1:#3987e5;--s2:#d95926;--s3:#199e70;--s4:#c98500;--s5:#d55181;--s6:#008300;--s7:#9085e9;--s8:#e66767;
    --up:#0ca30c;--down:#e66767;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --page:#0d0d0d;--surface:#1a1a19;--surface-2:#232322;--ink:#ffffff;--ink-2:#c3c2b7;--muted:#898781;--grid:#2c2c2a;--axis:#383835;--border:rgba(255,255,255,.10);
  --s1:#3987e5;--s2:#d95926;--s3:#199e70;--s4:#c98500;--s5:#d55181;--s6:#008300;--s7:#9085e9;--s8:#e66767;
  --up:#0ca30c;--down:#e66767;
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--page);color:var(--ink);font:14px/1.5 system-ui,-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif}
a{color:var(--s1);text-decoration:none}a:hover{text-decoration:underline}
header{position:sticky;top:0;z-index:20;background:var(--surface);border-bottom:1px solid var(--grid);padding:8px 16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
header h1{font-size:17px;margin:0;font-weight:700}
header .sub{color:var(--ink-2);font-size:12px}
header .spacer{flex:1}
.btn{border:1px solid var(--border);background:var(--surface-2);color:var(--ink);border-radius:8px;padding:5px 10px;font-size:12px;cursor:pointer}
.btn:hover{border-color:var(--axis)}
nav.tabs{display:flex;gap:4px;overflow-x:auto;padding:6px 12px;background:var(--surface);border-bottom:1px solid var(--grid);position:sticky;top:49px;z-index:19}
nav.tabs button{white-space:nowrap;border:0;background:transparent;color:var(--ink-2);padding:8px 12px;border-radius:8px;font-size:14px;cursor:pointer}
nav.tabs button.active{background:var(--surface-2);color:var(--ink);font-weight:600}
nav.tabs button .n{display:inline-block;min-width:18px;padding:0 5px;border-radius:9px;background:var(--critical);color:#fff;font-size:11px;margin-left:4px;text-align:center}
main{max-width:1380px;margin:0 auto;padding:12px 16px 60px}
section.tab{display:none}section.tab.active{display:block}
h2{font-size:16px;margin:22px 0 10px;display:flex;align-items:baseline;gap:8px}
h2 small{color:var(--muted);font-weight:400;font-size:12px}
h3{font-size:14px;margin:16px 0 8px;color:var(--ink-2)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:12px 14px;box-shadow:var(--shadow)}
.grid{display:grid;gap:10px}
.g-kpi{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
.g-2{grid-template-columns:repeat(auto-fit,minmax(340px,1fr))}
.g-3{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.tile{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:10px 12px;min-height:84px;display:flex;flex-direction:column;gap:2px}
.tile .l{font-size:12px;color:var(--ink-2);display:flex;justify-content:space-between;gap:6px}
.tile .v{font-size:22px;font-weight:600;letter-spacing:-.01em}
.tile .d{font-size:12px;color:var(--ink-2);display:flex;gap:8px;align-items:center}
.tile svg{width:100%;height:26px;margin-top:2px}
.up{color:var(--up)}.down{color:var(--down)}
.chip{display:inline-block;font-size:11px;padding:1px 7px;border-radius:10px;background:var(--surface-2);color:var(--ink-2);border:1px solid var(--border);margin-right:4px;white-space:nowrap}
.chip.r-crypto{border-color:var(--s1)}.chip.r-war{border-color:var(--s2)}.chip.r-ai{border-color:var(--s3)}.chip.r-all{border-color:var(--muted)}
.lvl{display:inline-flex;align-items:center;gap:4px;font-size:11px;padding:1px 8px;border-radius:10px;font-weight:600;white-space:nowrap}
.lvl.opportunity{background:var(--good-bg);color:var(--good)}
.lvl.warning{background:var(--warn-bg);color:#8a5a00}
.lvl.invalidation{background:var(--critical-bg);color:var(--critical)}
.lvl.event{background:var(--serious-bg);color:#a3421f}
.lvl.info{background:var(--info-bg);color:var(--ink-2)}
:root[data-theme="dark"] .lvl.warning{color:var(--warn)}
:root[data-theme="dark"] .lvl.event{color:var(--serious)}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .lvl.warning{color:var(--warn)} :root:not([data-theme="light"]) .lvl.event{color:var(--serious)} }
.new{background:var(--critical);color:#fff;font-size:10px;padding:0 5px;border-radius:8px;margin-left:4px}
.alert{border-left:4px solid var(--muted);padding:8px 10px;margin:6px 0;background:var(--surface);border-radius:6px;border-top:1px solid var(--border);border-right:1px solid var(--border);border-bottom:1px solid var(--border)}
.alert.opportunity{border-left-color:var(--good)}.alert.warning{border-left-color:var(--warn)}.alert.invalidation{border-left-color:var(--critical)}.alert.event{border-left-color:var(--serious)}
.alert .t{font-weight:600}.alert .w{color:var(--ink-2);font-size:12px;margin-top:2px}.alert .a{font-size:12px;margin-top:4px}.alert .s{font-size:11px;color:var(--muted);margin-top:2px}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;color:var(--ink-2);font-weight:600;font-size:12px;border-bottom:1px solid var(--axis);padding:6px 8px;white-space:nowrap;position:sticky;top:0;background:var(--surface)}
td{padding:6px 8px;border-bottom:1px solid var(--grid);vertical-align:top}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
tr:hover td{background:var(--surface-2)}
.tbl{overflow:auto;max-height:70vh;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}
.chart{height:280px;width:100%}
.chart-title{font-size:13px;color:var(--ink-2);margin:0 0 4px;display:flex;justify-content:space-between}
.legend{font-size:11px;color:var(--ink-2)}.legend i{display:inline-block;width:14px;height:2px;vertical-align:middle;margin:0 4px 0 8px}
.muted{color:var(--muted)}.small{font-size:12px}
.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle}
.st-fired .status-dot{background:var(--critical)}.st-idle .status-dot{background:var(--axis)}.st-nodata .status-dot{background:var(--warn)}
.news{list-style:none;padding:0;margin:0}
.news li{padding:8px 4px;border-bottom:1px solid var(--grid)}
.news li.read{opacity:.55}
.news .h{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.news .h .time{color:var(--muted);font-size:11px;white-space:nowrap;font-variant-numeric:tabular-nums}
.news .h .src{color:var(--ink-2);font-size:11px;white-space:nowrap}
.news .h .tier{font-size:10px;border:1px solid var(--border);border-radius:4px;padding:0 4px;color:var(--muted)}
.news .h .title{font-size:14px}
.news .sum{color:var(--ink-2);font-size:12px;margin-top:3px;display:none}
.reading .news .sum{display:block}
.news .hot{color:var(--critical);font-weight:700}
.filters{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0}
.filters select,.filters input{border:1px solid var(--border);background:var(--surface);color:var(--ink);border-radius:8px;padding:5px 8px;font-size:13px}
.filters label{font-size:12px;color:var(--ink-2);display:flex;align-items:center;gap:4px}
.dir{font-weight:700}.dir.u2{color:var(--up)}.dir.u1{color:var(--up)}.dir.d2{color:var(--down)}.dir.d1{color:var(--down)}.dir.p{color:var(--s2)}.dir.n{color:var(--muted)}
.mat td{font-size:12px}
.kv{display:grid;grid-template-columns:auto 1fr;gap:2px 10px;font-size:12px}
.kv b{color:var(--ink-2);font-weight:500}
.hot-card{display:flex;flex-direction:column;gap:4px}
.bar{height:8px;background:var(--surface-2);border-radius:4px;position:relative;overflow:hidden}
.bar i{position:absolute;top:0;bottom:0;background:var(--s2);opacity:.85;border-radius:4px}
.bar i.b5{background:var(--s1);opacity:.6}
.phase{border-left:3px solid var(--s1);padding:4px 10px;margin:6px 0}
.phase.p2{border-left-color:var(--s2)}.phase.p3{border-left-color:var(--s3)}
details summary{cursor:pointer;color:var(--ink-2);font-size:13px}
.footer{color:var(--muted);font-size:11px;margin-top:30px;border-top:1px solid var(--grid);padding-top:10px}
.pill-row{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}
.pill{font-size:12px;padding:3px 9px;border-radius:12px;border:1px solid var(--border);background:var(--surface);cursor:pointer}
.pill.active{background:var(--ink);color:var(--surface)}
@media (max-width:640px){main{padding:8px 12px 60px}.tile .v{font-size:19px}.chart{height:220px}nav.tabs{top:auto;position:static}header{position:static}}
{% endraw %}
</style>
</head>
<body>
<header>
  <h1>机会监控</h1>
  <span class="sub">数据日期 <b id="hdr-date">{{ date }}</b> · 生成于 <span id="hdr-gen">{{ generated_at }}</span></span>
  <span class="spacer"></span>
  <span class="sub" id="hdr-status"></span>
  <button class="btn" id="theme-btn" title="切换主题">🌗 主题</button>
</header>
<nav class="tabs" id="tabs">
  <button data-tab="overview" class="active">总览</button>
  <button data-tab="crypto">加密</button>
  <button data-tab="geo">地缘</button>
  <button data-tab="ai">AI 时代</button>
  <button data-tab="track">推演追踪</button>
  <button data-tab="read">阅读</button>
  <button data-tab="data">数据</button>
</nav>
<main>
  <section class="tab active" id="tab-overview"></section>
  <section class="tab" id="tab-crypto"></section>
  <section class="tab" id="tab-geo"></section>
  <section class="tab" id="tab-ai"></section>
  <section class="tab" id="tab-track"></section>
  <section class="tab" id="tab-read"></section>
  <section class="tab" id="tab-data"></section>
  <div class="footer">本页为基于公开数据与三篇研究报告的自动化监控，不构成投资建议。所有阈值来自报告原文；数据来源与时间戳见「数据」页。规则引擎不使用任何大模型。</div>
</main>
<script id="__DATA__" type="application/json">{{ data_json|safe }}</script>
<script src="assets/echarts.min.js"></script>
<script>
{% raw %}
if (!window.echarts) {
  var s = document.createElement('script'); s.src = 'https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js';
  s.onerror = function(){ var t=document.createElement('script'); t.src='https://registry.npmmirror.com/echarts/5.6.0/files/dist/echarts.min.js'; document.head.appendChild(t); };
  document.head.appendChild(s);
}
{% endraw %}
</script>
<script>
{% raw %}
(function(){
'use strict';
const D = JSON.parse(document.getElementById('__DATA__').textContent);
const M = D.metrics || {}, S = D.series || {};
const TODAY = D.date;
const LS = (k, v) => { try { if (v === undefined) return localStorage.getItem(k); localStorage.setItem(k, v); } catch(e){ return null; } };

// ---------- helpers ----------
const v = k => (M[k] && M[k].value != null) ? +M[k].value : null;
const meta = k => (M[k] && M[k].meta) || {};
const dOf = k => M[k] ? (M[k].asof || M[k].date) : null;
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function fmtPx(x){ if (x == null || isNaN(x)) return '—'; const a=Math.abs(x); if (a>=1e12) return (x/1e12).toFixed(2)+'T'; if (a>=1e9) return (x/1e9).toFixed(2)+'B'; if (a>=1e6) return (x/1e6).toFixed(1)+'M'; if (a>=1000) return x.toLocaleString('en-US',{maximumFractionDigits:0}); if (a>=1) return x.toFixed(2); if (a>=0.01) return x.toFixed(4); return x.toPrecision(3); }
function fmtPct(x,d){ if (x == null || isNaN(x)) return '—'; d = d==null?1:d; return (x>0?'+':'')+x.toFixed(d)+'%'; }
function fmtNum(x,d){ if (x == null || isNaN(x)) return '—'; return x.toFixed(d==null?2:d); }
const cls = x => x == null ? '' : (x > 0 ? 'up' : (x < 0 ? 'down' : ''));
const rl = r => ({crypto:'加密',war:'地缘',ai:'AI',all:'宏观'}[r] || r || '');
const LEVEL = {opportunity:['▲','机会'],warning:['⚠','风险'],invalidation:['✖','失效'],event:['◆','事件'],info:['●','信息']};
const lvl = l => { const x = LEVEL[l] || LEVEL.info; return `<span class="lvl ${l}">${x[0]} ${x[1]}</span>`; };
const chip = (t, r) => `<span class="chip r-${r||''}">${esc(t)}</span>`;
function spark(key, n){ const s = S[key]; if (!s || s.length < 3) return ''; const pts = s.slice(-(n||40)); const ys = pts.map(p=>p[1]); const mn=Math.min(...ys), mx=Math.max(...ys); const w=100,h=26; const d = pts.map((p,i)=>{ const x=i/(pts.length-1)*w; const y = mx===mn?h/2:h-((p[1]-mn)/(mx-mn))*(h-4)-2; return (i?'L':'M')+x.toFixed(1)+','+y.toFixed(1); }).join(''); const up = ys[ys.length-1] >= ys[0]; return `<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" aria-hidden="true"><path d="${d}" fill="none" stroke="${up?'var(--s3)':'var(--s2)'}" stroke-width="1.5" vector-effect="non-scaling-stroke"/></svg>`; }
function tile(o){ const val = v(o.key); const f = o.fmt==='pct'? fmtPct(val, o.d) : o.fmt==='num'? fmtNum(val, o.d) : fmtPx(val); const dk = o.delta; const dv = dk ? v(dk) : null; const dtxt = dv==null ? '' : `<span class="${cls(dv)}">${fmtPct(dv)}</span><span class="muted">${o.deltaLabel||'1d'}</span>`; const sub = o.sub ? `<span class="muted">${esc(o.sub)}</span>` : ''; const asof = dOf(o.key); return `<div class="tile" title="${esc(o.key)} · ${esc(asof||'')}"><div class="l"><span>${esc(o.label)}</span><span class="muted">${esc((asof||'').slice(5,10))}</span></div><div class="v">${o.prefix||''}${f}${o.unit||''}</div><div class="d">${dtxt}${sub}</div>${o.spark?spark(o.spark):''}</div>`; }
function pctCell(x,d){ return `<td class="num ${cls(x)}">${fmtPct(x,d)}</td>`; }
function daysLabel(n){ if (n==null) return ''; n = Math.round(n); if (n===0) return '今天'; if (n>0) return `${n} 天后`; return `${-n} 天前`; }
const cssVar = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();

// ---------- charts ----------
const charts = [];
function lineChart(id, opt){
  const el = document.getElementById(id); if (!el || !window.echarts) { if (el) el.innerHTML = '<div class="muted small">图表库未加载（离线且无本地 echarts）。数值见表格。</div>'; return; }
  const ink2 = cssVar('--ink-2'), grid = cssVar('--grid'), axis = cssVar('--axis'), surface = cssVar('--surface');
  const colors = [cssVar('--s1'), cssVar('--s2'), cssVar('--s3'), cssVar('--s4'), cssVar('--s7'), cssVar('--s5')];
  const series = (opt.series||[]).map((s,i)=>{ let data = S[s.key] || []; if (s.transform) data = s.transform(data); if (opt.days) data = data.slice(-opt.days); return { name:s.name, type:'line', showSymbol:false, symbol:'circle', symbolSize:6, lineStyle:{width:s.width||2}, itemStyle:{color:s.color||colors[i%colors.length]}, data, connectNulls:true, areaStyle: s.area?{opacity:.08}:undefined, emphasis:{focus:'series'} }; }).filter(s=>s.data.length);
  if (!series.length){ el.innerHTML = '<div class="muted small">暂无数据</div>'; return; }
  const ml = (opt.markLines||[]).map(m=>({ yAxis:m.y, name:m.label, lineStyle:{type:'dashed', color:m.color||ink2, width:1}, label:{formatter:m.label, position:'insideEndTop', color:ink2, fontSize:11} }));
  if (ml.length) series[0].markLine = { silent:true, symbol:'none', data: ml };
  const ch = echarts.init(el, null, {renderer:'canvas'});
  ch.setOption({
    animation:false, color: colors, backgroundColor:'transparent',
    grid:{left:8,right:16,top:28,bottom:24,containLabel:true},
    legend:{show: series.length>1, top:0, textStyle:{color:ink2,fontSize:11}, icon:'rect', itemWidth:14, itemHeight:2},
    tooltip:{trigger:'axis', axisPointer:{type:'cross', lineStyle:{color:axis}, label:{backgroundColor:ink2}}, backgroundColor:surface, borderColor:grid, textStyle:{color:cssVar('--ink'), fontSize:12}, valueFormatter: val => opt.yFmt ? opt.yFmt(val) : fmtPx(val)},
    xAxis:{type:'time', axisLine:{lineStyle:{color:axis}}, axisLabel:{color:ink2, fontSize:11}, splitLine:{show:false}},
    yAxis:{type: opt.log?'log':'value', scale:true, axisLabel:{color:ink2, fontSize:11, formatter: val => opt.yFmt ? opt.yFmt(val) : fmtPx(val)}, splitLine:{lineStyle:{color:grid}}, axisLine:{show:false}, min: opt.min, max: opt.max},
    series
  });
  charts.push(ch);
}
function chartBox(id, title, legendHtml){ return `<div class="card"><div class="chart-title"><span>${esc(title)}</span><span class="legend">${legendHtml||''}</span></div><div class="chart" id="${id}"></div></div>`; }
window.addEventListener('resize', ()=>charts.forEach(c=>c.resize()));

// ---------- rules ----------
const RULES = D.rules || [];
const fired = RULES.filter(r=>r.fired).sort((a,b)=> (a.priority-b.priority) || (a.is_new===b.is_new?0:(a.is_new?-1:1)));
function alertCard(r){ return `<div class="alert ${r.level}"><div class="t">${lvl(r.level)} ${esc(r.title)}${r.is_new?'<span class="new">新</span>':''} <span class="muted small">${r.first_fired && r.first_fired!==TODAY ? '自 '+r.first_fired : ''}</span></div><div class="w">${esc(r.why)}</div><div class="a">→ ${esc(r.action||'')}</div><div class="s">${chip(rl(r.report), r.report)}${(r.assets||[]).map(a=>chip(a)).join('')} 依据：${esc(r.source||'')}</div></div>`; }
function rulesTable(report){ const rows = RULES.filter(r=>!report || r.report===report || r.report==='all'); rows.sort((a,b)=>{ const o={fired:0,nodata:2,idle:1}; return (o[a.status]-o[b.status]) || (a.priority-b.priority); }); return `<div class="tbl"><table><thead><tr><th>状态</th><th>条件</th><th>当前读数</th><th>触发后的动作</th><th>依据</th></tr></thead><tbody>${rows.map(r=>`<tr class="st-${r.status}"><td><span class="status-dot"></span>${r.status==='fired'?'<b>触发</b>':(r.status==='nodata'?'无数据':'未触发')}${r.is_new?'<span class="new">新</span>':''}</td><td>${lvl(r.level)} ${esc(r.title)}<div class="small muted">${(r.assets||[]).map(a=>chip(a)).join('')}</div></td><td class="small">${esc(r.why)}</td><td class="small">${esc(r.action||'')}</td><td class="small muted">${esc(r.source||'')}</td></tr>`).join('')}</tbody></table></div>`; }

// ---------- watch tables ----------
const YAHOO = (D.watch && D.watch.yahoo) || [];
const ANCH = (D.watch && D.watch.anchors) || {};
function watchTable(groups, report){ const items = YAHOO.filter(y => groups ? groups.includes(y.group) : (!report || y.report===report)); let cur=''; let html = `<div class="tbl"><table><thead><tr><th>标的</th><th class="num">价格</th><th class="num">1d</th><th class="num">7d</th><th class="num">30d</th><th class="num">YTD</th><th class="num">1y</th><th class="num">较52周高</th><th class="num">较报告锚点</th><th>日期</th></tr></thead><tbody>`; for (const y of items){ if (y.group!==cur){ cur=y.group; html += `<tr><td colspan="10" style="background:var(--surface-2);font-weight:600">${esc(cur)}</td></tr>`; } const k=y.key; const px=v('px.'+k); if (px==null){ html += `<tr><td>${esc(y.label)} <span class="muted small">${esc(y.symbol)}</span></td><td colspan="9" class="muted small">无数据</td></tr>`; continue; } const ddA = v('dd_ath.'+k); html += `<tr><td>${esc(y.label)} <span class="muted small">${esc(y.symbol)}</span></td><td class="num">${fmtPx(px)}</td>${pctCell(v('chg1d.'+k))}${pctCell(v('chg7d.'+k))}${pctCell(v('chg30d.'+k))}${pctCell(v('ytd.'+k))}${pctCell(v('chg1y.'+k))}${pctCell(v('dd52w.'+k))}<td class="num ${cls(ddA)}">${ddA==null?'—':fmtPct(ddA)}${ANCH[k]?`<div class="muted" style="font-size:10px">锚 ${fmtPx(ANCH[k].ath)}</div>`:''}</td><td class="small muted">${esc((dOf('px.'+k)||'').slice(0,10))}</td></tr>`; } return html + '</tbody></table></div>'; }

// ---------- calendar ----------
const CAL = D.calendar || [];
function calTable(filterFn, limit){ const rows = CAL.filter(e=>e.days_to >= -3).filter(filterFn||(()=>true)).slice(0, limit||200); return `<div class="tbl"><table><thead><tr><th>日期</th><th>倒计时</th><th>事件</th><th>报告</th><th>影响标的</th><th>说明</th></tr></thead><tbody>${rows.map(e=>`<tr><td class="num">${e.date}${e.approx?'<span class="muted">≈</span>':''}</td><td class="num ${e.days_to<=7?'down':''}">${daysLabel(e.days_to)}</td><td>${esc(e.title)}</td><td>${chip(rl(e.report), e.report)}</td><td>${(e.assets||[]).map(a=>chip(a)).join('')}</td><td class="small muted">${esc(e.note||'')}</td></tr>`).join('')}</tbody></table></div>`; }

// ---------- news ----------
const NEWS = D.news || [];
const TOPICS = D.topics || {};
const readSet = new Set((LS('read')||'').split(',').filter(Boolean));
function newsItem(n, showSum){ const t = (n.published||n.first_seen||'').replace('T',' ').slice(5,16); const topics=(n.topics||[]).map(tp=>chip((TOPICS[tp]&&TOPICS[tp].label)||tp, TOPICS[tp]&&TOPICS[tp].report)).join(''); const hot = n.score>=3.5; return `<li class="${readSet.has(n.id)?'read':''}" data-id="${n.id}"><div class="h"><span class="time">${t}</span><span class="src">${esc(n.source)}</span><span class="tier">T${n.tier||'?'}</span>${hot?'<span class="hot">●</span>':''}<a class="title" href="${esc(n.link)}" target="_blank" rel="noopener">${esc(n.title)}</a></div><div>${topics}</div>${n.summary?`<div class="sum">${esc(n.summary)}</div>`:''}</li>`; }
function newsList(items){ return `<ul class="news">${items.map(n=>newsItem(n)).join('')}</ul>`; }
function topNews(filterFn, n){ const now = Date.now(); return NEWS.filter(x=>filterFn?filterFn(x):true).map(x=>{ const t = Date.parse(x.published||x.first_seen||0)||0; const age = (now-t)/3.6e6; return {x, s:(x.score||0) - Math.max(0, age-24)/24}; }).sort((a,b)=>b.s-a.s).slice(0,n).map(o=>o.x); }
document.addEventListener('click', e => { const li = e.target.closest && e.target.closest('li[data-id]'); if (li && e.target.tagName==='A'){ readSet.add(li.dataset.id); li.classList.add('read'); LS('read', Array.from(readSet).slice(-3000).join(',')); } });

