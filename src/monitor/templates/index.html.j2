  <div class="filters"><label>报告 <select id="f-report"><option value="">全部</option><option value="crypto">加密</option><option value="war">地缘</option><option value="ai">AI 时代</option><option value="all">宏观</option></select></label>
  <label>话题 <select id="f-topic"><option value="">全部</option>${topicOpts}</select></label>
  <label>语言 <select id="f-lang"><option value="">全部</option><option value="zh">中文</option><option value="en">English</option></select></label>
  <label>排序 <select id="f-sort"><option value="score">敏感度</option><option value="time">时间</option></select></label>
  <label><input type="checkbox" id="f-hot"> 只看敏感（权重≥3）</label>
  <label><input type="checkbox" id="f-unread"> 隐藏已读</label>
  <label><input type="checkbox" id="f-reading"> 研读模式（显示摘要）</label>
  <input id="f-q" placeholder="搜索标题/摘要…" style="min-width:200px"></div>
  <div class="card" id="read-list"></div>`;
  const apply = () => {
    const rep = document.getElementById('f-report').value, tp = document.getElementById('f-topic').value, lang = document.getElementById('f-lang').value, sort = document.getElementById('f-sort').value, hot = document.getElementById('f-hot').checked, unread = document.getElementById('f-unread').checked, q = document.getElementById('f-q').value.trim().toLowerCase();
    document.getElementById('read-list').classList.toggle('reading', document.getElementById('f-reading').checked);
    let items = NEWS.filter(n => (!rep || (n.topics||[]).some(t=>TOPICS[t]&&TOPICS[t].report===rep)) && (!tp || (n.topics||[]).includes(tp)) && (!lang || n.lang===lang) && (!hot || n.score>=3) && (!unread || !readSet.has(n.id)) && (!q || (n.title+' '+(n.summary||'')).toLowerCase().includes(q)));
    if (sort==='score') items = topNews(x=>items.includes(x), 400); else items = items.slice(0, 400);
    document.getElementById('read-list').innerHTML = items.length ? newsList(items) : '<span class="muted">没有匹配的新闻</span>';
  };
  el.querySelectorAll('select,input').forEach(x=>x.addEventListener('change', apply));
  document.getElementById('f-q').addEventListener('input', apply);
  el.querySelectorAll('.pill[data-topic]').forEach(p=>p.addEventListener('click', ()=>{ document.getElementById('f-topic').value = p.dataset.topic; apply(); }));
  apply();
}

// ================= DATA =================
function renderData(){
  const el = document.getElementById('tab-data');
  const run = D.run || {};
  let h = `<h2>抓取器状态 <small>生成于 ${esc(D.generated_at)} · 总耗时 ${run.duration_s||'?'}s</small></h2><div class="tbl"><table><thead><tr><th>抓取器</th><th>状态</th><th class="num">指标</th><th class="num">回填</th><th class="num">新闻</th><th class="num">秒</th><th>备注</th></tr></thead><tbody>`;
  for (const [k,s] of Object.entries(run.fetchers||{})) h += `<tr><td><b>${k}</b></td><td>${s.skipped?'<span class="muted">未运行</span>':(s.ok?'<span class="up">正常</span>':'<span class="down">失败</span>')}${s.stale_from?`<div class="muted" style="font-size:10px">上次运行 ${esc(String(s.stale_from).slice(0,16))}</div>`:''}</td><td class="num">${s.metrics??''}</td><td class="num">${s.backfill??''}</td><td class="num">${s.news??''}</td><td class="num">${s.seconds??''}</td><td class="small muted">${esc(s.error||s.notes||'')}</td></tr>`;
  h += `</tbody></table></div>`;
  const sub = ((run.fetchers||{}).extras||{}).sub_status || {};
  if (Object.keys(sub).length) h += `<h3>专项来源（extras）</h3><div class="card small">${Object.entries(sub).map(([k,s])=>`<span class="chip" title="${esc(s.error||'')}">${s.ok?'✔':'✖'} ${esc(k)} ${s.n!=null?'('+s.n+')':''}</span>`).join(' ')}</div>`;
  const fs = run.feed_status || {};
  const fsE = Object.entries(fs); const okN = fsE.filter(([k,s])=>s.ok).length;
  h += `<h2>新闻源 <small>${okN}/${fsE.length} 正常</small></h2><div class="tbl"><table><thead><tr><th>来源</th><th>状态</th><th class="num">条数</th><th>错误</th></tr></thead><tbody>${fsE.sort((a,b)=>(a[1].ok===b[1].ok?0:(a[1].ok?1:-1))).map(([k,s])=>`<tr><td>${esc(k)}</td><td>${s.ok?'<span class="up">✔</span>':'<span class="down">✖</span>'}</td><td class="num">${s.n??''}</td><td class="small muted">${esc(s.error||'')}</td></tr>`).join('')}</tbody></table></div>`;
  const stale = Object.entries(M).filter(([k,m])=>k.startsWith('px.') || k.startsWith('pm.') || k.startsWith('stable.') || k.startsWith('fred.')).map(([k,m])=>({k, d:m.date})).filter(x=>{ const age=(Date.parse(TODAY)-Date.parse(x.d))/864e5; return age>3; });
  h += `<h2>过期指标 <small>超过 3 天未更新（周末/假日属正常）</small></h2><div class="card small">${stale.length? stale.map(x=>`<span class="chip">${esc(x.k)} ${x.d}</span>`).join(' ') : '<span class="muted">无</span>'}</div>`;
  h += `<h2>来源等级与准确性约定</h2><div class="card small"><b>T1</b> 官方/一手（美联储、SEC、财政部、交易所与协议链上数据、DefiLlama、Polymarket 成交价）· <b>T2</b> 主流媒体与成熟聚合（CoinDesk、The Block、CNBC、Google News 检索到的路透/彭博等）· <b>T3</b> 二级聚合/博客（仅作线索，需二次核实）。<br>价格类数据：CoinGecko 与 Binance/Yahoo 交叉；FRED 失败时以财政部收益率曲线兜底。所有指标带时间戳；规则在数据缺失时显示"无数据"而非猜测。<br>本工具不使用大模型改写或总结任何内容；新闻只做关键词打标与排序。</div>`;
  if (ST.data_gaps) h += `<h2>报告自述的数据缺口</h2><div class="card small">${ST.data_gaps.map(g=>`<div>· ${esc(g)}</div>`).join('')}</div>`;
  h += `<h2>指标字典 <small>${Object.keys(M).length} 个键</small></h2><details><summary>展开全部指标（键 · 值 · 日期 · 来源）</summary><div class="tbl" style="max-height:60vh"><table><thead><tr><th>键</th><th class="num">值</th><th>日期</th><th>来源</th></tr></thead><tbody>${Object.entries(M).sort().map(([k,m])=>`<tr><td class="small">${esc(k)}</td><td class="num small">${m.value==null?'—':fmtPx(+m.value)}</td><td class="small">${esc(m.asof||m.date||'')}</td><td class="small muted">${esc(m.source||'')}</td></tr>`).join('')}</tbody></table></div></details>`;
  el.innerHTML = h;
}

// ---------- tabs & theme ----------
const renderers = {overview:renderOverview, crypto:renderCrypto, geo:renderGeo, ai:renderAI, track:renderTrack, read:renderRead, data:renderData};
const rendered = {};
function show(tab){ document.querySelectorAll('nav.tabs button').forEach(b=>b.classList.toggle('active', b.dataset.tab===tab)); document.querySelectorAll('section.tab').forEach(s=>s.classList.toggle('active', s.id==='tab-'+tab)); if (!rendered[tab]){ try { renderers[tab](); } catch(e){ document.getElementById('tab-'+tab).innerHTML = '<div class="card down">渲染错误：'+esc(e.message)+'</div>'; console.error(e); } rendered[tab]=true; } setTimeout(()=>charts.forEach(c=>c.resize()),0); LS('tab', tab); }
document.getElementById('tabs').addEventListener('click', e=>{ const b=e.target.closest('button'); if (b) show(b.dataset.tab); });
const themeBtn = document.getElementById('theme-btn');
function applyTheme(t){ if (t==='auto') document.documentElement.removeAttribute('data-theme'); else document.documentElement.setAttribute('data-theme', t); LS('theme', t); }
applyTheme(LS('theme')||'auto');
themeBtn.addEventListener('click', ()=>{ const cur = LS('theme')||'auto'; const nxt = cur==='auto'?'dark':(cur==='dark'?'light':'auto'); applyTheme(nxt); charts.length=0; Object.keys(rendered).forEach(k=>rendered[k]=false); show(document.querySelector('nav.tabs button.active').dataset.tab); });
function boot(){ renderOverview(); rendered.overview = true; const last = LS('tab'); if (last && last!=='overview' && renderers[last]) show(last); }
if (window.echarts) boot(); else { let n=0; const t=setInterval(()=>{ if (window.echarts || ++n>40){ clearInterval(t); boot(); } }, 100); }
})();
{% endraw %}
</script>
</body>
</html>
