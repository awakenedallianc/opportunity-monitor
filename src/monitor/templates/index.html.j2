// ================= TRACK =================
function renderTrack(){
  const el = document.getElementById('tab-track');
  let h = `<h2>三篇报告 <small>基准日 2026-09-20 · 本页把报告结论当作"待验证的推演"逐日对照</small></h2><div class="grid g-3">`;
  for (const r of REPORTS){ h += `<div class="card"><b>${esc(r.title)}</b> <span class="muted small">${esc(r.window||'')}</span><div class="small" style="margin-top:6px">${esc(r.thesis||'')}</div><div class="small" style="margin-top:6px"><a href="${esc(r.file)}" target="_blank">打开原报告 ↗</a> <span class="muted">（若托管版本未包含原文，请在本机打开）</span></div></div>`; }
  h += `</div>`;
  if (BASE.length){
    h += `<h2>基线 vs 现在 <small>报告写下的数字，今天是多少</small></h2><div class="tbl"><table><thead><tr><th>报告</th><th>指标</th><th class="num">报告基线</th><th class="num">现在</th><th class="num">变化</th><th>说明</th></tr></thead><tbody>`;
    for (const b of BASE){ const chg = b.change_pts!=null ? `<span class="${cls(b.change_pts)}">${(b.change_pts>0?'+':'')+b.change_pts.toFixed(2)} pp</span>` : (b.change_pct==null?'—':`<span class="${cls(b.change_pct)}">${fmtPct(b.change_pct)}</span>`); h += `<tr><td>${chip(rl(b.report), b.report)}</td><td>${esc(b.label)}<div class="muted" style="font-size:11px">${esc(b.metric||'')}</div></td><td class="num">${esc(b.baseline_display||fmtPx(b.baseline_value))}<div class="muted" style="font-size:10px">${esc(b.baseline_date||'')}</div></td><td class="num">${b.now==null?'<span class="muted">无数据</span>':(b.fmt==='pct'?fmtPct(b.now):(b.fmt==='num'?fmtNum(b.now,2):fmtPx(b.now)))}<div class="muted" style="font-size:10px">${esc(b.now_date||'')}</div></td><td class="num">${chg}</td><td class="small muted">${esc(b.note||'')}</td></tr>`; }
    h += `</tbody></table></div>`;
  }
  const hist = D.alerts_history || [];
  if (hist.length){ const byDate = {}; for (const a of hist){ (byDate[a.date] = byDate[a.date] || []).push(a); } const dates = Object.keys(byDate).sort().reverse(); h += `<h2>推演变化日志 <small>每日触发的规则（最近 120 天）</small></h2><div class="card">`; for (const d of dates.slice(0,60)){ h += `<div style="padding:4px 0;border-bottom:1px solid var(--grid)"><b class="small">${d}</b> ${byDate[d].map(a=>`${lvl(a.level)} <span class="small">${esc(a.title)}</span>`).join(' · ')}</div>`; } h += `</div>`; }
  h += `<h2>完整触发日历</h2>` + calTable(null, 200);
  const runs = D.runs || [];
  if (runs.length) h += `<h2>运行记录</h2><div class="tbl"><table><thead><tr><th>时间</th><th class="num">耗时(s)</th><th>抓取器</th></tr></thead><tbody>${runs.slice(0,15).map(r=>`<tr><td class="num small">${esc(r.run_at)}</td><td class="num">${fmtNum(r.duration_s,0)}</td><td class="small">${Object.entries(r.status||{}).map(([k,s])=>`${k}:${s.skipped?'跳过':(s.ok?'✔':'✖')}`).join(' ')}</td></tr>`).join('')}</tbody></table></div>`;
  el.innerHTML = h;
}

